# ========================================================
# Campus360 - Login Module Environment Configuration
# ========================================================

# Application Settings
NODE_ENV=development
PORT=3000
APP_NAME=Campus360-AuthModule
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Security & Tokens
JWT_ACCESS_SECRET=campus360_super_secret_access_jwt_key_2026_dev!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=campus360_super_secret_refresh_jwt_key_2026_dev!
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=campus360_auth
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_WAIT_FOR_CONNECTIONS=true

# Caching Layer (Redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SECONDS=3600

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# External Integration & Webhook Security
EXTERNAL_API_KEY=campus360_external_sync_key_93817f7b2c9a41e089d5119
EXTERNAL_WEBHOOK_URL=http://localhost:3000/api/v1/external/webhook

# Logging
LOG_LEVEL=debug
LOG_FILE_PATH=./logs

# Alerting
ALERT_WEBHOOK_URL=
ALERT_EMAIL_RECIPIENT=admin@campus360.internal
